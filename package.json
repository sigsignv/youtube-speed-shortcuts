{
  "private": true,
  "name": "youtube-speed-shortcuts",
  "description": "Sets YouTube playback speed with keyboard shortcuts.",
  "version": "0.1.0",
  "author": "Sigsign <sig@signote.cc>",
  "license": "Apache-2.0",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@wxt-dev/auto-icons": "^1.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wxt": "^0.21.3"
  }
}
